# Copy this file to .env and fill in the real values. Never commit .env.

# Supabase dashboard: Project Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx   # Settings > API Keys > Secret keys (never the publishable key)

# Only needed for embeddings_with_voyage.py
VOYAGE_API_KEY=your-voyage-key
# Optional: change the Voyage model (the table dimension must match, see sql/01_create_tables.sql)
# VOYAGE_MODEL=voyage-3.5-lite

# Used later by llm.py
GROQ_API_KEY=your-groq-key

# Login tokens (auth.py). At least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Only when the website is served from its own address (not through a proxy). Comma separated, no spaces needed.
# CORS_ALLOWED_ORIGINS=https://hr.example.com,http://localhost:5173
