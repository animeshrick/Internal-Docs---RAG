# Copy this file to .env and fill in the real values. Never commit .env.

# Supabase dashboard: Project Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx   # Settings > API Keys > Secret keys (never the publishable key)

# Only needed for embeddings_with_voyage.py
VOYAGE_API_KEY=your-voyage-key
# Optional: change the Voyage model (the table dimension must match, see sql/01_create_tables.sql)
# VOYAGE_MODEL=voyage-3.5-lite

# Used later by llm.py
GROQ_API_KEY=your-groq-key

# Login tokens (auth.py). At least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# How much the logs say: DEBUG, INFO (default), WARNING, ERROR.
# Logs go to stderr, so "python -m app.rag.ingest.chunking > report.txt" keeps them apart.
# LOG_LEVEL=INFO

# Only when the website is served from its own address (not through a proxy). Comma separated, no spaces needed.
# CORS_ALLOWED_ORIGINS=https://hr.example.com,http://localhost:5173

# Set true only when the API runs behind a trusted proxy/load balancer that sets X-Forwarded-For (needed for the office-network check)
TRUST_PROXY_HEADERS=false

# WhatsApp HR report (attendance/leave/WFH), sent twice a day at 11am and 5pm India time via
# AiSensy to the numbers the super admin manages. See areas/hrms-whatsapp-report.md for how to
# set up the AiSensy account and template. Both of the first two are required - sending raises a
# clear error until they're set. AISENSY_SENDER_NAME is optional (defaults to "HR Assistant").
AISENSY_API_KEY=your-aisensy-api-key
AISENSY_CAMPAIGN_NAME=your-aisensy-campaign-name
# AISENSY_SENDER_NAME=HR Assistant

# Per-page planned maintenance. Comma-separated page keys, no spaces needed. Leave unset/empty
# for normal operation (nothing down). Valid keys: home, chat, documents, leave_and_wfh,
# payslips, approvals, attendance, me, admin, superadmin. See areas/hrms-downtime.md.
# DOWNTIME_PAGES=payslips,admin